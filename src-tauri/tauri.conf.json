{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByteMap",
  "version": "0.1.0",
  "identifier": "io.github.archanagaur175-glitch.bytemap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "npm run build:helper",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ByteMap",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ByteMap",
    "copyright": "Copyright (c) 2026 ByteMap contributors",
    "category": "Utility",
    "shortDescription": "Local disk-space analyzer for Windows 11",
    "longDescription": "ByteMap scans a drive or folder, shows where the space goes with orbit and treemap views, and helps you clean up safely. Everything stays on your PC.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../target/release/bytemap-helper.exe": "bytemap-helper.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
